{
  "name": "saza-event-portal",
  "version": "1.0.0",
  "description": "Client Portal & Agency Workspace for Event Agency",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/server/http/server.ts",
    "dev": "node --experimental-strip-types --watch src/server/http/server.ts",
    "worker": "node --experimental-strip-types src/server/jobs/run-worker.ts",
    "worker:once": "node --experimental-strip-types src/server/jobs/run-worker.ts --once",
    "test": "node --experimental-strip-types tests/run-all-tests.ts && node --experimental-strip-types tests/test-http-server.ts",
    "test:unit": "node --experimental-strip-types tests/run-all-tests.ts",
    "test:t01-t40": "node --experimental-strip-types tests/run-all-tests.ts",
    "test:http": "node --experimental-strip-types tests/test-http-server.ts",
    "seed": "node --experimental-strip-types src/server/seed/run-seed.ts",
    "status": "node -e 'console.log(\"Event Portal status: Ready\")'"
  },
  "keywords": [
    "event-portal",
    "client-portal",
    "event-management",
    "agency-workspace"
  ],
  "author": "Antigravity Engineering",
  "license": "UNLICENSED"
}
